# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
DATABASE_URL=postgresql+psycopg://aiwriter:replace-with-local-password@localhost:5432/aiwriter

# Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=30

# Local frontend settings (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Local Docker Compose PostgreSQL only; choose a private development password
POSTGRES_DB=aiwriter
POSTGRES_USER=aiwriter
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
